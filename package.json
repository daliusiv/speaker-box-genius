{
  "name": "speaker-box-genius",
  "private": true,
  "description": "Web-based loudspeaker enclosure and passive radiator simulator — a modern WinISD.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "pnpm --filter @sbg/web dev",
    "build": "pnpm build:db && pnpm --filter @sbg/web build && pnpm build:site",
    "build:site": "node --experimental-strip-types --disable-warning=ExperimentalWarning site/build.ts packages/web/dist",
    "build:db": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/db-tools/src/bundle.ts --out packages/web/public/db",
    "validate:db": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/db-tools/src/validate.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"packages/*/test/*.test.ts\" \"site/*.test.ts\"",
    "typecheck": "tsc -p packages/schema && tsc -p packages/engine && tsc -p packages/db-tools && tsc -p packages/web",
    "db:import-wdr": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/db-tools/src/import-wdr.ts",
    "db:import-driverbase": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/db-tools/src/driverbase.ts",
    "db:import-sheet": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/db-tools/src/import-sheet.ts",
    "validation:report": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/engine/validation/report.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^7.0.0"
  }
}
