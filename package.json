{
  "name": "speaker-box-genius",
  "private": true,
  "description": "Web-based loudspeaker enclosure and passive radiator simulator — a modern WinISD.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "pnpm --filter @sbg/web dev",
    "build": "pnpm build:db && pnpm --filter @sbg/web build && pnpm build:site",
    "build:site": "node --experimental-strip-types --disable-warning=ExperimentalWarning site/build.ts packages/web/dist",
    "build:db": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/db-tools/src/bundle.ts --out packages/web/public/db",
    "validate:db": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/db-tools/src/validate.ts",
    "db:review": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/db-tools/src/review.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"packages/*/test/*.test.ts\" \"site/*.test.ts\"",
    "typecheck": "tsc -p packages/schema && tsc -p packages/engine && tsc -p packages/db-tools && tsc -p packages/headless && tsc -p packages/mcp && tsc -p packages/submit-worker && tsc -p packages/web",
    "tokens": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/web/scripts/tokens.ts",
    "lint": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/web/scripts/tokens.ts --check && pnpm --filter @sbg/web exec stylelint \"src/**/*.css\"",
    "test:ui": "pnpm --filter @sbg/web exec playwright test",
    "test:ui:update": "pnpm --filter @sbg/web exec playwright test --update-snapshots",
    "db:import-wdr": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/db-tools/src/import-wdr.ts",
    "db:import-driverbase": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/db-tools/src/driverbase.ts",
    "db:import-sheet": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/db-tools/src/import-sheet.ts",
    "validation:report": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/engine/validation/report.ts",
    "spice:netlists": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/engine/validation/spice/fixtures.ts",
    "spice:case": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/engine/validation/spice-cli.ts case",
    "spice:ngspice": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/engine/validation/spice-cli.ts ngspice",
    "spice:summary": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/engine/validation/spice-cli.ts summary",
    "spice:report": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/engine/validation/spice-report.ts",
    "spice:generate": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/engine/validation/spice/cases.ts",
    "mcp": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/mcp/src/main.ts mcp --db .",
    "mcp:build": "pnpm --filter @sbg/mcp run build && pnpm --filter @sbg/mcp run package"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^7.0.0"
  },
  "pnpm": {
    "overrides": {
      "@anthropic-ai/mcpb>zod": "4.6.7",
      "tmp": "0.2.7"
    }
  }
}
